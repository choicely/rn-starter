{
  "name": "rn-starter",
  "version": "1.0.0",
  "description": "React Native starter module for embedding Choicely RN components in a native Android app",
  "private": true,
  "license": "Elastic-2.0",
  "homepage": "https://docs.choicely.com/android-advanced/react-native",
  "scripts": {
    "start": "react-native start --host 0.0.0.0",
    "bundle": "mkdir -p ../app/src/main/assets && react-native bundle --platform android --dev false --entry-file src/index.js --bundle-output ../app/src/main/assets/index.android.bundle --assets-dest ../app/src/main/res",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "8.13.0",
    "@notifee/react-native": "9.1.8",
    "@react-native-clipboard/clipboard": "1.16.3",
    "@react-native-community/blur": "4.4.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/geolocation": "3.4.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/react-native-skia": "2.6.2",
    "llama.rn": "0.11.5",
    "lottie-react-native": "7.3.6",
    "react": "19.1.1",
    "react-native": "0.82.0",
    "react-native-background-actions": "4.1.0",
    "react-native-biometrics": "3.0.1",
    "react-native-blob-util": "0.24.9",
    "react-native-device-info": "15.0.2",
    "react-native-gesture-handler": "2.31.1",
    "react-native-haptic-feedback": "3.0.0",
    "react-native-image-picker": "8.2.1",
    "react-native-linear-gradient": "2.8.3",
    "react-native-localize": "3.7.0",
    "react-native-maps": "1.27.2",
    "react-native-mmkv": "4.3.1",
    "react-native-nitro-modules": "0.35.5",
    "react-native-pager-view": "8.0.1",
    "react-native-permissions": "5.5.1",
    "react-native-reanimated": "4.3.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.24.0",
    "react-native-sensors": "7.3.6",
    "react-native-share": "12.2.6",
    "react-native-svg": "15.15.4",
    "react-native-torch": "1.2.0",
    "react-native-track-player": "4.1.2",
    "react-native-vector-icons": "10.3.0",
    "react-native-video": "6.19.1",
    "react-native-vision-camera": "4.7.3",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-env": "7.29.2",
    "@babel/runtime": "7.29.2",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.82.0",
    "@react-native/metro-config": "0.82.0",
    "metro-cache": "0.82.0",
    "patch-package": "^8.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
